{
  "name": "vait-homepage",
  "version": "2.0.0",
  "description": "VAIT Homepage",
  "type": "module",
  "scripts": {
    "prepare": "pnpm run githooks:init",
    "githooks:init": "husky",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:CI": "pnpm run test && pnpm run typecheck",
    "test:preview": "vitest-preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "lint:fix:unsafe": "oxlint --fix-dangerously && oxfmt --write",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "ci": "oxlint && oxfmt --check",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "lucide": "^1.39.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@tanstack/router-cli": "^1.167.33",
    "@tanstack/router-vite-plugin": "^1.167.35",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-prepush": "^3.0.3",
    "lint-staged": "^17.4.1",
    "oxc-transform-react": "^0.148.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-preview": "^0.0.3",
    "wrangler": "^4.128.0"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
